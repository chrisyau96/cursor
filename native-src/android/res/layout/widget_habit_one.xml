<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widgetEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/widget_empty"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/habitOneRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/habitOneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habitOneCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#64748B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habitOneComplete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_plus"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/widget_plus"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/habitOneReset"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_btn_reset"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/widget_reset"
            android:textColor="#334155"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
